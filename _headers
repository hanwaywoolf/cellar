# Cloudflare Pages custom headers

# Manifest — Chrome Android requires this exact MIME type
/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Service worker — must never be cached so the browser always checks for updates
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# App shell — always fresh so updates are picked up immediately
/index.html
  Cache-Control: no-cache

# App source files
/store.jsx
  Cache-Control: no-cache
/backup.jsx
  Cache-Control: no-cache
/screen-backup.jsx
  Cache-Control: no-cache
